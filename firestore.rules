rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public read: published services, site content, stats
    match /services/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /siteContent/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /siteStats/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /testimonials/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Destinations: public read, auth write
    match /destinations/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Slots: public read (to show availability), auth write (admin manages slots)
    match /slots/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Bookings: anyone can create (public booking), only auth can read/update/delete
    match /bookings/{docId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Leads: write from public (contact form), read only by authenticated admin
    match /leads/{docId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Newsletter signups: anyone can subscribe, only admin can read/manage
    match /newsletter/{docId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Users/admin data: authenticated only
    match /users/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
